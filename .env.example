# ============================================
# PI Environment Variables 模板
# 复制为 .env 后填入实际值，不要提交 .env
# start.sh / start.ps1 会自动加载本文件
# ============================================

# —— 飞书开放平台凭证（pi-feishu 使用） ——
FEISHU_APP_ID=cli_aXXXXXXXXXXXXXXXX
FEISHU_APP_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# —— LiteLLM / MaaS 网关 ——
LITELLM_BASE_URL=http://your-gateway.example.org/maas/v1
LITELLM_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
LITELLM_DEFAULT_MODEL=GLM-5.3

# —— kubectl 工具白名单（可选） ——
# 默认读取 .pi/extensions/kubectl.tools；需要指向其他文件时取消下一行注释
# KUBECTL_TOOLS_FILE=/absolute/path/to/kubectl.tools
