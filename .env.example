# ============================================
# PI Environment Variables 模板
# 复制为 .env 后填入实际值，不要提交 .env
# start.sh / start.ps1 会自动加载本文件
# ============================================

# —— 飞书开放平台凭证（pi-feishu 使用） ——
# ┌───────────┬───────────────┬─────────────────────────────────────────────────────────────┐ 
# │ 优先级    │ 通道          │ 具体来源                                                    │ 
# ├───────────┼───────────────┼─────────────────────────────────────────────────────────────┤ 
# | 1（最高） │ CLI 标志      │ --feishu-app-id, --feishu-app-secret, --feishu-domain, 等   │ 
# ├───────────┼───────────────┼─────────────────────────────────────────────────────────────┤ 
# │ 2         │ 环境变量      │ FEISHU_APP_ID, FEISHU_APP_SECRET（.env 加载）               │ 
# ├───────────┼───────────────┼─────────────────────────────────────────────────────────────┤ 
# │ 3（最低） │ settings.json │ ~/.pi/agent/settings.json 或项目 .pi/settings.json 的 feishu 字段 │ 
# └───────────┴───────────────┴─────────────────────────────────────────────────────────────┘
#FEISHU_APP_ID=cli_aXXXXXXXXXXXXXXXX
#FEISHU_APP_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# —— LiteLLM / MaaS 网关 ——
LITELLM_BASE_URL=http://your-gateway.example.org/maas/v1
LITELLM_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
LITELLM_DEFAULT_MODEL=GLM-5.3

# —— kubectl 工具白名单（可选） ——
# 默认读取 .pi/extensions/kubectl.tools；需要指向其他文件时取消下一行注释
# KUBECTL_TOOLS_FILE=/absolute/path/to/kubectl.tools

# —— 进程管理 Web UI（extensions/webserver，可选） ——
# 不设则默认启用（仅 RPC 模式）；设为 0 禁用
# 除环境变量外，也可在 .pi/settings.json 的 "web" 字段配置（优先级更高，仅生效值）：
#   { "web": { "enabled": true, "host": "0.0.0.0", "port": 3170, "token": "..." } }
# PI_WEB_ENABLED=1
# PI_WEB_HOST=127.0.0.1
# PI_WEB_PORT=3170
# 保护查询接口的 Bearer Token；不设则免鉴权
# PI_WEB_TOKEN=

# —— sidecar 守护进程（extensions/sidecar，可选） ——
# start 脚本默认拉起 sidecar 托管 pi RPC（崩溃自动重启 + 注册中心）；设为 0 回退旧版直启
# PI_SIDECAR_ENABLED=1
# 运行模式：master | slave；不设则 auto（配了 PI_SIDECAR_MASTER_URL 为 slave，否则 master）
# PI_SIDECAR_MODE=master
# slave 模式必填：master 节点的注册中心地址（master 自己不需要）
# PI_SIDECAR_MASTER_URL=http://master-host:3180
# master 模式注册中心监听地址与端口
# PI_SIDECAR_REGISTRY_HOST=127.0.0.1
# PI_SIDECAR_REGISTRY_PORT=3180
# 每节点 RPC HTTP 中继监听地址与端口（跨机消息落点；默认 0.0.0.0:派生置端口 30000..49999）
# PI_SIDECAR_RELAY_HOST=0.0.0.0
# PI_SIDECAR_RELAY_PORT=
# 注册/心跳/查询接口的 Bearer Token；不设则免鉴权
# PI_SIDECAR_TOKEN=
# 节点 ID；不设则默认 <hostname>-<workdir 哈希前 6 位>
# PI_SIDECAR_NODE_ID=
# 心跳间隔秒（默认 10）；超时判定秒（默认 30）；离线清理保留秒（默认 3600）
# PI_SIDECAR_HEARTBEAT_INTERVAL=10
# PI_SIDECAR_HEARTBEAT_TIMEOUT=30
# PI_SIDECAR_OFFLINE_RETENTION=3600
# pi 崩溃重启退避封顶秒（默认 30，从 1s 起指数退避）
# PI_SIDECAR_BACKOFF_CAP=30
# 优雅停止等待秒（stop 脚本与 sidecar 均使用，默认 15）
# PI_STOP_TIMEOUT=15
# sidecar 托管的 pi 子进程启动命令（默认：pi --mode rpc --approve）。
# 可在此追加 pi CLI 参数，例如续最近会话 + 使用项目内会话目录：
# PI_SIDECAR_CHILD_CMD="pi --mode rpc --approve --continue --session-dir .pi/sessions"
# （直启 keeper 模式同样读取该变量，两处配置统一）
